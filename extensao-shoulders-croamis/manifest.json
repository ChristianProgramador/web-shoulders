{
  "manifest_version": 3,
  "name": "Shoulders - Automação CROAMIS LATAM",
  "version": "1.0",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://127.0.0.1/*",
    "*://localhost/*",
    "https://*.github.io/*",
    "*://croamis.latamcargo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://127.0.0.1/*",
        "*://localhost/*",
        "https://*.github.io/*",
        "*://croamis.latamcargo.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}